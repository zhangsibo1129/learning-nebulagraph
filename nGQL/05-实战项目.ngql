USE team_graph;
CREATE TAG IF NOT EXISTS person (name string, age int, city string);
CREATE TAG IF NOT EXISTS organization (name string, industry string);
CREATE TAG IF NOT EXISTS project (name string, status string);
CREATE TAG IF NOT EXISTS skill (name string);
CREATE EDGE IF NOT EXISTS works_at (position string, start_year int);
CREATE EDGE IF NOT EXISTS works_on (role string);
CREATE EDGE IF NOT EXISTS has_skill (level int);
CREATE EDGE IF NOT EXISTS cooperates_with (since date);
CREATE EDGE IF NOT EXISTS belongs_to ();
INSERT VERTEX organization (name, industry) VALUES "org1": ("NebulaTech", "Database"), "org2": ("GraphSoft", "Graph Computing"), "org3": ("DataWorks", "Big Data");
INSERT VERTEX project (name, status) VALUES "proj1": ("NebulaGraph 3.8", "active"), "proj2": ("Graph Studio", "active"), "proj3": ("Data Pipeline", "finished"), "proj4": ("AI 推荐系统", "active");
INSERT VERTEX skill (name) VALUES "sk1": ("Python"), "sk2": ("Go"), "sk3": ("Java"), "sk4": ("C++"), "sk5": ("SQL"), "sk6": ("机器学习");
INSERT VERTEX person (name, age, city) VALUES "p1": ("Alice", 30, "北京"), "p2": ("Bob", 25, "上海"), "p3": ("Carol", 35, "北京"), "p4": ("Dave", 28, "深圳"), "p5": ("Eve", 32, "上海"), "p6": ("Frank", 29, "北京"), "p7": ("Grace", 27, "杭州");
INSERT EDGE works_at (position, start_year) VALUES "p1" -> "org1": ("Engineer", 2019), "p2" -> "org1": ("Engineer", 2020), "p3" -> "org2": ("Manager", 2016), "p4" -> "org3": ("Analyst", 2021), "p5" -> "org2": ("Engineer", 2018), "p6" -> "org1": ("Architect", 2017), "p7" -> "org3": ("Engineer", 2022), "p2" -> "org2": ("Consultant", 2022);
INSERT EDGE works_on (role) VALUES "p1" -> "proj1": ("核心开发"), "p2" -> "proj1": ("测试"), "p6" -> "proj1": ("架构设计"), "p3" -> "proj2": ("产品经理"), "p5" -> "proj2": ("前端开发"), "p4" -> "proj3": ("数据开发"), "p7" -> "proj3": ("数据开发"), "p1" -> "proj4": ("算法工程师"), "p7" -> "proj4": ("算法工程师");
INSERT EDGE has_skill (level) VALUES "p1" -> "sk1": (5), "p1" -> "sk6": (4), "p2" -> "sk2": (4), "p2" -> "sk5": (3), "p3" -> "sk3": (5), "p4" -> "sk5": (5), "p4" -> "sk1": (3), "p5" -> "sk1": (4), "p5" -> "sk3": (3), "p6" -> "sk4": (5), "p6" -> "sk2": (4), "p7" -> "sk1": (4), "p7" -> "sk6": (5);
INSERT EDGE cooperates_with (since) VALUES "p1" -> "p2": (date("2020-03-01")), "p1" -> "p6": (date("2019-08-15")), "p2" -> "p6": (date("2020-05-20")), "p3" -> "p5": (date("2018-01-10")), "p4" -> "p7": (date("2022-02-14")), "p5" -> "p3": (date("2018-01-10")), "p6" -> "p1": (date("2019-08-15"));
INSERT EDGE belongs_to () VALUES "proj1" -> "org1": (), "proj2" -> "org2": (), "proj3" -> "org3": (), "proj4" -> "org1": ();
MATCH (a:person)-[:works_at]->(o:organization)<-[:works_at]-(b:person) WHERE id(a) == "p1" AND id(a) != id(b) RETURN b.person.name AS colleague, o.organization.name AS company;
MATCH (p:project)<-[:works_on]-(a:person) WHERE id(p) == "proj1" RETURN a.person.name AS member, p.project.name AS project;
MATCH (a:person)-[:has_skill]->(s:skill) WHERE s.skill.name == "Python" RETURN a.person.name AS person, s.skill.name AS skill;
MATCH (a:person)-[:has_skill]->(s1:skill {name: "Python"}), (a:person)-[:has_skill]->(s2:skill {name: "机器学习"}) RETURN a.person.name AS person;
MATCH (a:person)-[:works_at]->(o:organization)<-[:works_at]-(b:person)-[:works_at]->(o2:organization)<-[:works_at]-(c:person) WHERE id(a) == "p1" AND id(a) != id(c) AND id(b) != id(c) RETURN DISTINCT c.person.name AS colleague_of_colleague;
MATCH (a:person)-[:cooperates_with]-(b:person) WHERE id(a) == "p1" RETURN b.person.name AS partner;
MATCH (a:person)-[:cooperates_with*2]-(b:person) WHERE id(a) == "p1" AND id(a) != id(b) RETURN DISTINCT b.person.name AS partner2;
MATCH (a:person)-[:works_at]->(o:organization) RETURN o.organization.name AS company, count(*) AS emp_cnt ORDER BY emp_cnt DESC;
MATCH (a:person)-[:works_on]->(p:project) RETURN p.project.name AS project, count(*) AS member_cnt ORDER BY member_cnt DESC;
MATCH (a:person)-[:works_at]->(o:organization {name: "NebulaTech"}), (a:person)-[:has_skill]->(s:skill {name: "Python"}) RETURN a.person.name AS person;
MATCH p = (a:person)-[:cooperates_with*1..3]-(b:person) WHERE id(a) == "p1" AND id(b) == "p7" RETURN p;
MATCH (p:project)-[:belongs_to]->(o:organization) RETURN p.project.name AS project, o.organization.name AS org;
CREATE TAG INDEX IF NOT EXISTS person_name_index ON person(name(32));
CREATE TAG INDEX IF NOT EXISTS organization_name_index ON organization(name(32));
CREATE TAG INDEX IF NOT EXISTS skill_name_index ON skill(name(32));
CREATE TAG INDEX IF NOT EXISTS project_name_index ON project(name(32));
REBUILD TAG INDEX person_name_index;
REBUILD TAG INDEX organization_name_index;
REBUILD TAG INDEX skill_name_index;
REBUILD TAG INDEX project_name_index;
LOOKUP ON person WHERE person.name == "Alice" YIELD person.name, person.age;